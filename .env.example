# Copy to .env and fill in. NEVER commit .env.

# --- Sources (READ ONLY) ---
SOURCE_MONGO_URI=mongodb+srv://<readonly-user>@<ops-cluster>/playda
SOURCE_DB_NAME=playda
SOURCE_CRM_MONGO_URI=mongodb+srv://<readonly-user>@<crm-cluster>/playda_crm
SOURCE_CRM_DB_NAME=playda_crm

# --- Target (WRITE, on the CRM cluster) ---
DEMO_MONGO_URI=mongodb+srv://<demo-writer>@<crm-cluster>/
DEMO_OPS_DB_NAME=playda_demo
DEMO_CRM_DB_NAME=playda_crm_demo

# Safety latch — must equal the db being refreshed (playda_demo or
# playda_crm_demo) or every write aborts.
CONFIRM_TARGET=playda_demo

# Masking — same salt across ops+crm copies keeps identities consistent.
# Rotate to re-randomize every masked identity on next refresh.
DEMO_SALT=change-me-to-a-long-random-string

# Whitelisted demo attendees (keep real contact data → can actually log in).
DEMO_WHITELIST_MOBILES=+9715XXXXXXX
DEMO_WHITELIST_EMAILS=demo.owner@yourdomain.com,demo.admin@yourdomain.com

# Demo accounts inserted into playda_demo on every refresh.
DEMO_ADMIN_EMAIL=demo.admin@yourdomain.com
DEMO_OWNER_EMAIL=demo.owner@yourdomain.com
DEMO_MANAGER_EMAIL=

# API auth — /api/demo/* accepts X-Job-Token or an admin-role playda-be JWT.
DEMO_JOB_TOKEN=some-long-random-token
JWT_SECRET_KEY=<same-as-playda-be>

LOG_LEVEL=INFO
